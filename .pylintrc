[MASTER]
ignored-modules=tkinter,tkinter.font,tkinter.ttk,tkinter.messagebox,tkinter.filedialog,tkinter.colorchooser,tkinter.simpledialog,tkinter.scrolledtext,_tkinter,_t

[FORMAT]
max-line-length=120

[DESIGN]
max-args=10
max-locals=20
max-branches=15
max-statements=60
max-attributes=20
max-returns=8

[SIMILARITIES]
min-similarity-lines=10
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
