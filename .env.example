# Variáveis de ambiente do Codis
#
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# O arquivo .env NÃO deve ser commitado (está no .gitignore).
# Este .env.example documenta todas as variáveis disponíveis.

# DESENVOLVIMENTO

# Ativa logs detalhados de debug (EventBus, LSP, plugins, performance)
# CODIS_DEBUG=1

# Desativa carregamento de plugins ao iniciar (útil para debugar)
# CODIS_NO_PLUGINS=1

# Força um locale específico independente das configurações salvas
# CODIS_LOCALE=en

# Diretório de dados alternativo (padrão: ~/.codis)
# CODIS_DATA_DIR=/tmp/codis-dev

# PROVEDORES DE IA

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini)
# GOOGLE_API_KEY=AIza...

# Groq
# GROQ_API_KEY=gsk_...

# OpenRouter
# OPENROUTER_API_KEY=sk-or-...

# URL base customizada para APIs compatíveis com OpenAI (Ollama, LM Studio, etc.)
# CODIS_AI_BASE_URL=http://localhost:11434/v1
# CODIS_AI_API_KEY=ollama

# LSP

# Caminho explícito para o servidor LSP Python (se não estiver no PATH)
# CODIS_PYLSP_PATH=/home/usuario/.venv/bin/pylsp

# Timeout de inicialização do LSP em milissegundos (padrão: 10000)
# CODIS_LSP_TIMEOUT=10000

# PERFORMANCE

# Desativa animações (útil em máquinas lentas ou acesso remoto)
# CODIS_NO_ANIMATIONS=1

# Força modo de arquivo grande para todos os arquivos (debug)
# CODIS_FORCE_LARGE_FILE=1
